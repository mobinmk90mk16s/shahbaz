APP_NAME="Shahbaz"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shahbaz
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
SMS_DRIVER=http
# JSON HTTP contract: POST {to, message, sender_id}, Authorization: Bearer <token>
# Configure these using the API contract supplied by your selected SMS provider.
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=

VITE_APP_NAME="${APP_NAME}"
